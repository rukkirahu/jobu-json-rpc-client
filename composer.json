{
    "name": "jobu/json-rpc-client",
    "description": "Synchronous PHP client for the JobU JSON-RPC Unix socket",
    "type": "library",
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Jobu\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "php tests/client.php",
            "php tests/services.php",
            "php tests/status.php",
            "php tests/ui.php",
            "php tests/ui-jobs.php",
            "php tests/ui-runs.php",
            "php tests/ui-security.php"
        ]
    }
}